{
  "functions": {
    "api/dist/index.mjs": {
      "maxDuration": 10
    }
  },
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/dist/index.mjs" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
