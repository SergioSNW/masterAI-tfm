{
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.mjs", "type": "backend" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
