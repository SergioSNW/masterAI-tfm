{
  "name": "masterai-tfm",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/infrastructure",
    "api",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "prisma:generate": "npm run prisma:generate -w packages/infrastructure",
    "prisma:migrate": "npm run prisma:migrate -w packages/infrastructure",
    "dev:web": "npm run dev -w apps/web",
    "build:api": "npx esbuild api/index.ts --bundle --platform=node --format=esm --external:@prisma/client --external:@vercel/blob --outfile=api/dist/index.mjs",
    "build:web": "npm run build:api && npm run build -w apps/web",
    "dev:mobile": "npm run start -w apps/mobile",
    "dev:mobile:web": "npm run web -w apps/mobile",
    "test": "npm run test -w packages/core && npm run test -w packages/infrastructure && npm run test -w apps/web",
    "test:core": "npm run test -w packages/core",
    "test:infra": "npm run test -w packages/infrastructure",
    "test:web": "npm run test -w apps/web",
    "dev:all": "concurrently -n web,api,mobile -c blue,green,magenta \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:mobile\"",
    "dev:all:web": "concurrently -n web,mobile -c blue,magenta \"npm run dev:web\" \"npm run dev:mobile:web\"",
    "dev:api": "npx vercel dev --port 3000 --yes",
    "test:e2e": "npx playwright test --config e2e/playwright.config.ts",
    "test:all": "npm test && npm run test:e2e",
    "maestro:studio": "maestro studio -w apps/mobile",
    "maestro:test": "maestro test apps/mobile/.maestro/",
    "maestro:smoke": "maestro test apps/mobile/.maestro/ --include-tags=smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "react-native": "^0.86.2",
    "react-test-renderer": "^19.2.7",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "react-native-worklets": "^0.5.1"
  }
}
