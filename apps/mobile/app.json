{
  "expo": {
    "name": "MasterAI Casting",
    "slug": "masterai-casting",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "masterai-casting",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png", 
      "backgroundColor": "#07070d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masterai.casting"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07070d"
      },
      "package": "com.masterai.casting"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a27d11d-9a7f-4c71-add7-497dc7852ba4"
      }
    }
  }
}