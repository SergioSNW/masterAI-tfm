# PostgreSQL connection string (Neon.tech)
DATABASE_URL=

# OpenAI API key (used by the AI analysis pipeline: Whisper transcription + GPT-4o-mini evaluation)
OPENAI_API_KEY=

# Cloudinary credentials (signed video upload pipeline — api/cloudinary/sign.ts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel Blob token, used by the document/attachment upload route (api/router.ts handleUploadRoute).
# Auto-injected by Vercel when Blob storage is linked to the project; only needed for local `vercel dev`.
BLOB_READ_WRITE_TOKEN=
